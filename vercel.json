{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "rm -rf public && mkdir -p public && cp -R front/. public/ && mkdir -p public/admin && cp -R admin/. public/admin/",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://39.106.117.134/api/:path*"
    }
  ]
}